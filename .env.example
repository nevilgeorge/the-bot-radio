# Copy to .env and fill in. .env is gitignored and loaded by web/config.py;
# variables already set in your shell take precedence over this file.

# Claude (services/claude_service.py)
ANTHROPIC_API_KEY=

# Spotify (services/spotify_service.py). Client id/secret from the app dashboard; get the
# refresh token once with `uv run python scripts/spotify_auth.py` while logged in as the bot.
# Scopes: playlist-modify-public playlist-modify-private playlist-read-private ugc-image-upload
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# NYC Open Data app token: optional, raises Socrata rate limits for the 311 input
NYC_OPEN_DATA_APP_TOKEN=

# Optional overrides (defaults shown). Leave commented unless you need them;
# the location defaults are what the tests expect.
# GREENPOINT_LAT=40.7295
# GREENPOINT_LON=-73.9540
# BOT_RADIO_ZIP=11222
# NOAA_TIDE_STATION=8517673
# BOT_RADIO_DATA_DIR=data
# BOT_RADIO_SITE_URL=https://thebotradio.com
# BOT_RADIO_INSTAGRAM_URL=
# BOT_RADIO_SPOTIFY_PROFILE_URL=
