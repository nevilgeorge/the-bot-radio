# Build and run with --platform linux/amd64 (ECS uses X86_64).
FROM python:3.13-slim-bookworm@sha256:281d39ff02e3b389401586134ff9e6572954687822a58055ec07a60ded4e0b7f AS builder
COPY --from=ghcr.io/astral-sh/uv:0.12.17@sha256:10787c682e4184e4f290de1171fd4703dc63de99221f10fe1c99002ce7fa9acc /uv /usr/local/bin/uv
ENV UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv
WORKDIR /build
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --locked --no-dev --no-install-project
COPY src/ ./src/
RUN uv sync --locked --no-dev --no-editable

FROM python:3.13-slim-bookworm@sha256:281d39ff02e3b389401586134ff9e6572954687822a58055ec07a60ded4e0b7f
ENV PATH=/opt/venv/bin:$PATH \
    HOME=/home/generator \
    BOT_RADIO_DATA_DIR=/work/data \
    TZ=America/New_York \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
RUN groupadd --gid 10001 generator \
    && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/generator generator \
    && mkdir -p /work/data \
    && chown -R 10001:10001 /work
COPY --from=builder /opt/venv /opt/venv
WORKDIR /work
USER 10001:10001
ENTRYPOINT ["the-bot-radio-generate"]
CMD ["--verbose"]
